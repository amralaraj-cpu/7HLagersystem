{
  "name": "CustomerTireSet",
  "type": "object",
  "properties": {
    "set_number": {
      "type": "string",
      "description": "Customer set ID e.g. CSET-0001"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "customer_name": {
      "type": "string"
    },
    "vehicle_registration": {
      "type": "string"
    },
    "vehicle_info": {
      "type": "string",
      "description": "Vehicle brand/model"
    },
    "tire_brand": {
      "type": "string"
    },
    "tire_dimension": {
      "type": "string"
    },
    "season": {
      "type": "string",
      "enum": [
        "summer",
        "winter",
        "all_season",
        "ms"
      ]
    },
    "studded": {
      "type": "boolean"
    },
    "total_tires": {
      "type": "number"
    },
    "tread_depths": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Tread depth for each tire"
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Warehouse positions (C- prefix)"
    },
    "check_in_date": {
      "type": "string",
      "format": "date"
    },
    "expected_pickup_date": {
      "type": "string",
      "format": "date"
    },
    "check_out_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "stored",
        "checked_out",
        "pending_pickup"
      ],
      "default": "stored"
    },
    "storage_fee_per_month": {
      "type": "number"
    },
    "total_fees_due": {
      "type": "number"
    },
    "last_payment_date": {
      "type": "string",
      "format": "date"
    },
    "condition_notes": {
      "type": "string"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qr_code": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "total_tires",
    "status"
  ]
}
